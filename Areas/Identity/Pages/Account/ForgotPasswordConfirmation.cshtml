@page
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center mt-4">
        <i class="fa-solid fa-circle-check text-success fa-3x mb-3"></i>
        <h2>Check your email</h2>
        <p class="text-muted">
            If an account with that email exists, a password reset link has been sent.
            (In this development environment, emails are saved to the <code>EmailLogs</code> folder instead of being delivered.)
        </p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary rounded-pill">Back to Login</a>
    </div>
</div>
