@page
@{
    ViewData["Title"] = "Reset Password Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center mt-4">
        <i class="fa-solid fa-circle-check text-success fa-3x mb-3"></i>
        <h2>Password Reset Complete</h2>
        <p class="text-muted">Your password has been reset. You can now log in with your new password.</p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary rounded-pill">Go to Login</a>
    </div>
</div>
