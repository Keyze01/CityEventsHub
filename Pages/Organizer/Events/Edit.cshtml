@page "{id:int}"
@model CityEventsHub.Pages.Organizer.Events.EditModel
@{
    ViewData["Title"] = "Edit Event";
}

<h1 class="mb-4"><i class="fa-solid fa-pen me-2"></i>Edit Event</h1>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        @if (!string.IsNullOrEmpty(Model.Input.ExistingImagePath))
        {
            <img src="@Model.Input.ExistingImagePath" class="rounded-4 mb-3" style="max-height:200px;object-fit:cover;" alt="Current event image" />
        }
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="EventId" />
            <input type="hidden" asp-for="Input.ExistingImagePath" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.CategoryId" class="form-label"></label>
                    <select asp-for="Input.CategoryId" class="form-select">
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Date" class="form-label"></label>
                    <input asp-for="Input.Date" class="form-control" type="date" />
                    <span asp-validation-for="Input.Date" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Time" class="form-label"></label>
                    <input asp-for="Input.Time" class="form-control" type="time" />
                    <span asp-validation-for="Input.Time" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.CityId" class="form-label"></label>
                    <select asp-for="Input.CityId" class="form-select">
                        @foreach (var city in Model.Cities)
                        {
                            <option value="@city.Id">@city.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CityId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Venue" class="form-label"></label>
                    <input asp-for="Input.Venue" class="form-control" />
                    <span asp-validation-for="Input.Venue" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Latitude" class="form-label"></label>
                    <input asp-for="Input.Latitude" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.Longitude" class="form-label"></label>
                    <input asp-for="Input.Longitude" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.ContactEmail" class="form-label"></label>
                    <input asp-for="Input.ContactEmail" class="form-control" />
                    <span asp-validation-for="Input.ContactEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PhoneNumber" class="form-label"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-4 form-check ms-3 mt-4">
                    <input asp-for="Input.RegistrationRequired" class="form-check-input" />
                    <label asp-for="Input.RegistrationRequired" class="form-check-label"></label>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.MaxAttendees" class="form-label"></label>
                    <input asp-for="Input.MaxAttendees" class="form-control" />
                    <span asp-validation-for="Input.MaxAttendees" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.ImageFile" class="form-label">Replace Image</label>
                    <input asp-for="Input.ImageFile" class="form-control" accept="image/*" />
                    <span asp-validation-for="Input.ImageFile" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill mt-4">
                <i class="fa-solid fa-floppy-disk me-1"></i>Save Changes
            </button>
            <a asp-page="/Organizer/Events/Index" class="btn btn-outline-secondary rounded-pill mt-4">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
