@page
@model CityEventsHub.Pages.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Home";
}

<!-- Hero section -->
<section class="hero-section rounded-4 p-5 mb-5 text-center">
    <span class="brand-chip mb-3">
        <i class="fa-solid fa-bolt"></i>@Localizer["Next-Gen Events"]
    </span>
    <h1 class="display-5 fw-bold mb-3">
        @Localizer["Events That"] <span class="hero-highlight">@Localizer["Bring Your City to Life"]</span>
    </h1>
    <p class="lead mb-4">@Localizer["Conferences, festivals, concerts, job fairs, and community events — all in one place."]</p>

    <form asp-page="/Events/Index" method="get" class="row g-2 justify-content-center bg-white rounded-4 p-3 shadow-sm mx-auto" style="max-width: 900px;">
        <div class="col-md-4">
            <input type="text" name="Keyword" class="form-control" placeholder="@Localizer["Search events..."]">
        </div>
        <div class="col-md-3">
            <select name="CategoryId" class="form-select">
                <option value="">@Localizer["All Categories"]</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="CityId" class="form-select">
                <option value="">@Localizer["All Cities"]</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.Id">@city.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-accent w-100 rounded-pill"><i class="fa-solid fa-magnifying-glass me-1"></i>@Localizer["Search"]</button>
        </div>
    </form>
</section>

<!-- Popular categories -->
<section class="mb-5">
    <h2 class="mb-3">@Localizer["Popular Categories"]</h2>
    <div class="row g-3">
        @foreach (var category in Model.Categories.Take(7))
        {
            <div class="col-6 col-md-3 col-lg-auto">
                <a asp-page="/Events/Index" asp-route-CategoryId="@category.Id" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 text-center category-tile h-100">
                        <div class="card-body">
                            <i class="@category.IconClass fa-2x text-primary mb-2"></i>
                            <p class="mb-0 small fw-semibold text-dark">@category.Name</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        <div class="col-6 col-md-3 col-lg-auto">
            <a asp-page="/Categories/Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 text-center category-tile h-100 bg-primary text-white">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <i class="fa-solid fa-ellipsis fa-2x mb-2"></i>
                        <p class="mb-0 small fw-semibold">View All</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Featured events -->
@if (Model.FeaturedEvents.Any())
{
    <section class="mb-5">
        <h2 class="mb-3">@Localizer["Featured Events"]</h2>
        <div class="row g-4">
            @foreach (var ev in Model.FeaturedEvents)
            {
                <div class="col-md-4">
                    <partial name="_EventCard" model="ev" />
                </div>
            }
        </div>
    </section>
}

<!-- Upcoming events -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@Localizer["Upcoming Events"]</h2>
        <a asp-page="/Events/Index" class="btn btn-outline-primary rounded-pill">@Localizer["Browse All Events"]</a>
    </div>
    @if (Model.UpcomingEvents.Any())
    {
        <div class="row g-4">
            @foreach (var ev in Model.UpcomingEvents)
            {
                <div class="col-md-4">
                    <partial name="_EventCard" model="ev" />
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">@Localizer["No upcoming events yet. Check back soon!"]</p>
    }
</section>

<!-- City selector -->
<section class="mb-5">
    <h2 class="mb-3">@Localizer["Browse by City"]</h2>
    <div class="row g-3">
        @foreach (var city in Model.Cities)
        {
            <div class="col-6 col-md-3">
                <a asp-page="/Events/Index" asp-route-CityId="@city.Id" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 text-center h-100">
                        <div class="card-body">
                            <i class="fa-solid fa-city fa-2x text-primary mb-2"></i>
                            <p class="mb-0 fw-semibold text-dark">@city.Name</p>
                            <p class="mb-0 small text-muted">@city.Country</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Interactive map placeholder -->
<section class="mb-5">
    <h2 class="mb-3">@Localizer["Explore on the Map"]</h2>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5 bg-light rounded-4">
            <i class="fa-solid fa-map-location-dot fa-3x text-primary mb-3"></i>
            <p class="text-muted mb-0">
                @Localizer["Interactive map integration placeholder — plug in a provider such as Leaflet or Google Maps using each event's Latitude/Longitude to show events geographically."]
            </p>
        </div>
    </div>
</section>
