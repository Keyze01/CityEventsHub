@page "{id:int}"
@model CityEventsHub.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Event.Title;
}

@if (Model.IsOwnerOrAdmin)
{
    @if (Model.Event.IsCancelled)
    {
        <div class="alert alert-danger">This event has been cancelled.</div>
    }
    else if (Model.Event.IsRejected)
    {
        <div class="alert alert-danger">This event was rejected. Reason: @Model.Event.RejectionReason</div>
    }
    else if (!Model.Event.IsApproved)
    {
        <div class="alert alert-warning">This event is pending administrator approval and is not yet publicly visible.</div>
    }
}

<div class="row g-4">
    <div class="col-lg-8">
        <img src="@(string.IsNullOrEmpty(Model.Event.ImagePath) ? "/images/event-placeholder.svg" : Model.Event.ImagePath)"
             class="img-fluid rounded-4 shadow-sm mb-4 w-100" alt="@Model.Event.Title" style="max-height:400px;object-fit:cover;" />

        <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill mb-2">@Model.Event.Category?.Name</span>
        <h1 class="mb-3">@Model.Event.Title</h1>
        <p class="lead">@Model.Event.Description</p>

        <div class="card border-0 shadow-sm rounded-4 mt-4">
            <div class="card-body">
                <h5 class="card-title mb-3">Event Details</h5>
                <p><i class="fa-solid fa-calendar-days me-2 text-primary"></i><strong>Date:</strong> @Model.Event.Date.ToString("MMMM dd, yyyy")</p>
                <p><i class="fa-solid fa-clock me-2 text-primary"></i><strong>Time:</strong> @Model.Event.Time.ToString(@"hh\:mm")</p>
                <p><i class="fa-solid fa-location-dot me-2 text-primary"></i><strong>Venue:</strong> @Model.Event.Venue, @Model.Event.City?.Name, @Model.Event.City?.Country</p>
                @if (Model.Event.RegistrationRequired)
                {
                    <p><i class="fa-solid fa-users me-2 text-primary"></i><strong>Attendees:</strong> @Model.AttendeeCount@(Model.Event.MaxAttendees.HasValue ? $" / {Model.Event.MaxAttendees}" : "")</p>
                }
                <p><i class="fa-solid fa-envelope me-2 text-primary"></i><strong>Contact:</strong> @Model.Event.ContactEmail @(string.IsNullOrEmpty(Model.Event.PhoneNumber) ? "" : $"| {Model.Event.PhoneNumber}")</p>
            </div>
        </div>

        @if (Model.Event.Latitude.HasValue && Model.Event.Longitude.HasValue)
        {
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-body text-center py-4 bg-light rounded-4">
                    <i class="fa-solid fa-map-location-dot fa-2x text-primary mb-2"></i>
                    <p class="text-muted mb-0 small">
                        Map placeholder for coordinates (@Model.Event.Latitude, @Model.Event.Longitude) — integrate Leaflet/Google Maps here.
                    </p>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mt-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    Reviews
                    @if (Model.AverageRating.HasValue)
                    {
                        <span class="text-warning ms-2"><i class="fa-solid fa-star"></i> @Model.AverageRating.Value.ToString("0.0")</span>
                        <span class="text-muted small">(@Model.Reviews.Count review@(Model.Reviews.Count == 1 ? "" : "s"))</span>
                    }
                </h5>
                @if (Model.Reviews.Any())
                {
                    foreach (var review in Model.Reviews)
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@review.User?.FullName</strong>
                                    <span class="text-warning ms-2">
                                        @for (var i = 0; i < review.Rating; i++)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                    </span>
                                    <p class="mb-0 text-muted small">@review.Comment</p>
                                </div>
                                @if (Model.MyReview is not null && Model.MyReview.Id == review.Id)
                                {
                                    <form method="post" asp-page-handler="DeleteReview" asp-route-id="@Model.Event.Id" asp-route-reviewId="@review.Id"
                                          onsubmit="return confirm('Delete your review?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No reviews yet.</p>
                }

                @if (Model.CanReview)
                {
                    <form method="post" asp-page-handler="SubmitReview" asp-route-id="@Model.Event.Id" class="mt-3 border-top pt-3">
                        <h6>Leave a Review</h6>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                        <div class="mb-2">
                            <label asp-for="ReviewInput.Rating" class="form-label small">Rating</label>
                            <select asp-for="ReviewInput.Rating" class="form-select form-select-sm" style="max-width:120px;">
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Good</option>
                                <option value="3">3 - Average</option>
                                <option value="2">2 - Poor</option>
                                <option value="1">1 - Terrible</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label asp-for="ReviewInput.Comment" class="form-label small"></label>
                            <textarea asp-for="ReviewInput.Comment" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill">Submit Review</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page-handler="ToggleFavorite" asp-route-id="@Model.Event.Id" class="mb-2">
                        <button type="submit" class="btn @(Model.IsFavorited ? "btn-danger" : "btn-outline-danger") w-100 rounded-pill">
                            <i class="fa-solid fa-heart me-1"></i>@(Model.IsFavorited ? "Remove Favorite" : "Add to Favorites")
                        </button>
                    </form>

                    @if (Model.Event.RegistrationRequired && !Model.Event.IsCancelled && !Model.Event.HasEnded)
                    {
                        @if (Model.HasRsvped)
                        {
                            <form method="post" asp-page-handler="CancelRsvp" asp-route-id="@Model.Event.Id">
                                <button type="submit" class="btn btn-outline-secondary w-100 rounded-pill">
                                    <i class="fa-solid fa-calendar-xmark me-1"></i>Cancel Registration
                                </button>
                            </form>
                        }
                        else if (Model.Event.MaxAttendees.HasValue && Model.AttendeeCount >= Model.Event.MaxAttendees.Value)
                        {
                            <button type="button" class="btn btn-secondary w-100 rounded-pill" disabled>Event Full</button>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Rsvp" asp-route-id="@Model.Event.Id">
                                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                                    <i class="fa-solid fa-calendar-check me-1"></i>RSVP to Attend
                                </button>
                            </form>
                        }
                    }
                }
                else
                {
                    <p class="text-muted small mb-2">Log in to favorite or RSVP to this event.</p>
                    <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Events/Details", new { id = Model.Event.Id })" class="btn btn-primary w-100 rounded-pill">
                        <i class="fa-solid fa-right-to-bracket me-1"></i>Login
                    </a>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h5 class="card-title">Organizer</h5>
                <p class="mb-1">@Model.Event.Organizer?.FullName</p>
                <p class="text-muted small">@Model.Event.Organizer?.Email</p>
            </div>
        </div>
    </div>
</div>
