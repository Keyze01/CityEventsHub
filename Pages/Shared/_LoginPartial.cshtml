@using Microsoft.AspNetCore.Identity
@using CityEventsHub.Helpers
@using CityEventsHub.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject INotificationService NotificationService

@{
    var unreadCount = SignInManager.IsSignedIn(User) ? await NotificationService.GetUnreadCountAsync(User.GetUserId()!) : 0;
}

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-circle-user me-1"></i>@User.Identity!.Name
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger rounded-pill">@unreadCount</span>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
            @if (User.IsInRole("Administrator"))
            {
                <li><a class="dropdown-item" asp-area="" asp-page="/Admin/Index"><i class="fa-solid fa-gauge me-2"></i>Admin Dashboard</a></li>
            }
            @if (User.IsInRole("Organizer"))
            {
                <li><a class="dropdown-item" asp-area="" asp-page="/Organizer/Index"><i class="fa-solid fa-gauge me-2"></i>Organizer Dashboard</a></li>
            }
            else if (!User.IsInRole("Administrator"))
            {
                <li><a class="dropdown-item" asp-area="" asp-page="/Organizer/Apply"><i class="fa-solid fa-briefcase me-2"></i>Become an Organizer</a></li>
            }
            <li><a class="dropdown-item" asp-area="" asp-page="/Account/Index"><i class="fa-solid fa-user me-2"></i>My Dashboard</a></li>
            <li><a class="dropdown-item" asp-area="" asp-page="/Favorites/Index"><i class="fa-solid fa-heart me-2"></i>My Favorites</a></li>
            <li>
                <a class="dropdown-item" asp-area="" asp-page="/Notifications/Index">
                    <i class="fa-solid fa-bell me-2"></i>Notifications
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1">@unreadCount</span>
                    }
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form id="logoutForm" class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                    <button type="submit" class="dropdown-item">
                        <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item d-flex align-items-center">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item d-flex align-items-center">
        <a class="btn btn-primary btn-sm rounded-pill ms-lg-2" asp-area="Identity" asp-page="/Account/Login">
            Login<i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
    </li>
}
</ul>
